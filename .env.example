# Copy these variable names into the OS, the IDE run configuration, or a secret manager.
# Never commit real credentials. Values below are examples only.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

MYSQL_URL=jdbc:mysql://<mysql-host>:3306/catgal?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8
MYSQL_USERNAME=<mysql-username>
MYSQL_PASSWORD=<mysql-password>
FLYWAY_ENABLED=false
# Existing non-empty databases need this only for the first controlled migration.
FLYWAY_BASELINE_ON_MIGRATE=false
DRUID_INITIAL_SIZE=5
DRUID_MIN_IDLE=5
DRUID_MAX_ACTIVE=20
DRUID_MAX_WAIT=60000

REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_DATABASE=0
REDIS_TIMEOUT=5000ms
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0

RABBITMQ_HOST=<rabbitmq-host>
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<rabbitmq-username>
RABBITMQ_PASSWORD=<rabbitmq-password>
RABBITMQ_VHOST=/

DASHSCOPE_API_KEY=<dashscope-api-key>
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_CHAT_TEMPERATURE=0.8
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024

ALIYUN_OSS_ENDPOINT=<oss-endpoint>
ALIYUN_OSS_ACCESS_KEY_ID=<oss-access-key-id>
ALIYUN_OSS_ACCESS_KEY_SECRET=<oss-access-key-secret>
ALIYUN_OSS_BUCKET_NAME=<oss-bucket-name>

# Generate at least 32 random bytes and Base64-encode them.
JWT_SECRET=<base64-encoded-32-byte-secret>
JWT_EXPIRE_MS=604800000
