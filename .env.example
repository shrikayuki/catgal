# Copy these variable names into the OS, the IDE run configuration, or a secret manager.
# Never commit real credentials. Values below are examples only.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

MYSQL_URL=jdbc:mysql://<mysql-host>:3306/catgal?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8
MYSQL_USERNAME=<mysql-username>
MYSQL_PASSWORD=<mysql-password>
FLYWAY_ENABLED=false
# Existing non-empty databases need this only for the first controlled migration.
FLYWAY_BASELINE_ON_MIGRATE=false
DRUID_INITIAL_SIZE=5
DRUID_MIN_IDLE=5
DRUID_MAX_ACTIVE=20
DRUID_MAX_WAIT=60000

REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_DATABASE=0
REDIS_TIMEOUT=5000ms
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0

RABBITMQ_HOST=<rabbitmq-host>
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<rabbitmq-username>
RABBITMQ_PASSWORD=<rabbitmq-password>
RABBITMQ_VHOST=/

AI_SERVICE_BASE_URL=http://127.0.0.1:8090
# Must equal AI_SERVICE_HMAC_SECRET in the Python service environment.
AI_SERVICE_HMAC_SECRET=<at-least-32-random-characters>
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_READ_TIMEOUT=75s
AI_SERVICE_STREAM_TIMEOUT=90s
AI_SERVICE_MVC_TIMEOUT=120s
# Enable in both Java and Python after V9 has been applied.
AI_PERSISTENCE_ENABLED=false
# Enable in both services only after V10 has been applied.
AI_PERSONALIZATION_ENABLED=false
AI_LONG_TERM_MEMORY_ENABLED=false
AI_MEMORY_VECTOR_ENABLED=false
LOAD_TEST_ENABLED=false
LOAD_TEST_TARGET_PORT=8080
LOAD_TEST_TARGET_PREFIX=
AI_SESSION_SUMMARY_ENABLED=false
AI_MEMORY_CANDIDATES_ENABLED=false
AI_GAME_TOOLS_ENABLED=false
AI_SEMANTIC_SEARCH_ENABLED=false

# Run V5 search migration and rebuild the index before enabling this switch.
GAME_SEARCH_ENABLED=false
ELASTICSEARCH_URL=http://192.168.150.104:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
GAME_SEARCH_ALIAS=catgal-game
GAME_SEARCH_TIMEOUT=3s
GAME_SEARCH_FAILURE_COOLDOWN=30s
GAME_SEARCH_BATCH_SIZE=200
GAME_SEARCH_SYNC_DELAY_MS=5000

# Run V6, rebuild game/resource indexes, then enable resource search.
RESOURCE_SEARCH_ENABLED=false
RESOURCE_SEARCH_ALIAS=catgal-resource

# External game catalogs. Public Bangumi subjects work without a token.
CATALOG_EXTERNAL_USER_AGENT=shrikayuki/catgal/0.1 (https://github.com/shrikayuki/catgal)
BANGUMI_ACCESS_TOKEN=
# Optional HTTP CONNECT proxy. Falls back to HTTPS_PROXY when unset.
CATALOG_EXTERNAL_PROXY_URL=

STORAGE_ENABLED=false
MINIO_ENDPOINT=http://192.168.150.104:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=catgal-media

# Generate at least 32 random bytes and Base64-encode them.
JWT_SECRET=<base64-encoded-32-byte-secret>
JWT_EXPIRE_MS=604800000
