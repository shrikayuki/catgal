<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.catgal.server.mapper.GameMapper">
    <!-- GameMapper 的复杂 SQL 映射，namespace 与 Java Mapper 全限定名对应。 -->

    <!-- 批量更新游戏统计数据 -->
    <!-- CASE id 为每行提供对应统计快照，WHERE 限定本批次 ID，调用后按 Redis 快照确认任务。 -->
    <update id="batchUpdateGameStats" parameterType="list">
        UPDATE game
        SET
        favorite_count = CASE id
        <foreach collection="list" item="game" separator=" ">
            WHEN #{game.id} THEN #{game.favoriteCount}
        </foreach>
        END,
        view_count = CASE id
        <foreach collection="list" item="game" separator=" ">
            WHEN #{game.id} THEN #{game.viewCount}
        </foreach>
        END,
        review_count = CASE id
        <foreach collection="list" item="game" separator=" ">
            WHEN #{game.id} THEN #{game.reviewCount}
        </foreach>
        END,
        download_count = CASE id
        <foreach collection="list" item="game" separator=" ">
            WHEN #{game.id} THEN #{game.downloadCount}
        </foreach>
        END
        <!-- 资源数由持久队列校准，评论数在评论事务更新，通用任务不能用旧缓存覆盖。 -->
        WHERE id IN
        <foreach collection="list" item="game" open="(" separator="," close=")">
            #{game.id}
        </foreach>
    </update>

</mapper>
