AI_APP_ENV=local
AI_SERVICE_HMAC_SECRET=replace-with-at-least-32-random-characters
AI_CHAT_API_KEY=replace-with-provider-api-key
AI_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_REDIS_URL=redis://:<redis-password>@<redis-host>:6379/0
# Apply V9 manually, then enable in both services.
AI_PERSISTENCE_ENABLED=false
AI_PERSONALIZATION_ENABLED=false
# Apply V12 manually before enabling. Each bot must also explicitly opt in.
AI_LONG_TERM_MEMORY_ENABLED=false
# V16, private index init and a separate per-bot explicit grant are required.
# Grant authorizes sending confirmed memory text and the current query (first 2000 code points)
# to the configured platform embedding provider. ES stores no private plaintext.
AI_MEMORY_VECTOR_ENABLED=false
AI_MEMORY_VECTOR_WORKER_ENABLED=false
AI_MEMORY_VECTOR_INDEX_NAME=catgal_memory_vectors_v1
AI_MEMORY_VECTOR_TIMEOUT_SECONDS=2
# Reuse platform AI_EMBEDDING_* and authenticated backend-only AI_SEMANTIC_ES_* transport.
# python -m app.memory_vector.worker init|status|drain|rebuild --maximum 100
# rebuild requeues existing V16 outbox rows. Migration seed + triggers maintain completeness.
# Global/model/index/restore changes require stopping workers and reviewing a fresh-index rebuild.
# Apply V14 manually. Each bot must separately opt in before new messages are considered.
AI_MEMORY_CANDIDATES_ENABLED=false
AI_CANDIDATE_EXTRACTION_TIMEOUT_SECONDS=8
AI_SESSION_SUMMARY_ENABLED=false
AI_SUMMARY_TIMEOUT_SECONDS=12
AI_SUMMARY_BATCH_TURNS=10
AI_SUMMARY_SOURCE_CHARS=24000
AI_GAME_TOOLS_ENABLED=false
# V15, Java catalog endpoints and an initialized compatible physical ES index are required.
# Semantic query text and compact public game documents use this separate platform key.
# Chat BYOK is independent. Off/unavailable falls back to the existing game query.
AI_SEMANTIC_SEARCH_ENABLED=false
AI_SEMANTIC_WORKER_ENABLED=false
AI_SEMANTIC_INDEX_NAME=catgal_game_vectors_v1
AI_SEMANTIC_ES_URL=http://192.168.150.104:9200
AI_SEMANTIC_ES_USERNAME=
AI_SEMANTIC_ES_PASSWORD=
AI_EMBEDDING_API_KEY=<platform-embedding-key>
AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_TIMEOUT_SECONDS=15
AI_SEMANTIC_TIMEOUT_SECONDS=3
# Manual CLI from ai-service: python -m app.semantic.worker init|status|drain|rebuild
# drain/rebuild default to at most 100 events, guarded across processes with MySQL GET_LOCK.
# Rebuild requeues this physical index. Model/dimension/restore changes require a fresh index name.
AI_JAVA_TOOLS_BASE_URL=http://127.0.0.1:8080
AI_TOOL_TIMEOUT_SECONDS=5
AI_MAX_TOOL_CALLS=4
# JSON key ring. Each value must be a Base64-encoded, random 32-byte key.
# Keep old key IDs available until all saved credentials have been re-encrypted.
AI_CREDENTIAL_ENCRYPTION_KEYS={"v1":"<base64-32-byte-key>"}
AI_CREDENTIAL_ACTIVE_KEY_ID=v1
# Only administrators configure provider endpoints. Users select a code and model.
AI_PROVIDER_ENDPOINTS={"dashscope":"https://dashscope.aliyuncs.com/compatible-mode/v1"}
AI_ASSET_HOSTS=[]
AI_MYSQL_HOST=192.168.150.104
AI_MYSQL_PORT=3306
AI_MYSQL_DATABASE=catgal
AI_MYSQL_USERNAME=<mysql-username>
AI_MYSQL_PASSWORD=<mysql-password>
AI_MODEL_TIMEOUT_SECONDS=60
AI_MODEL_MAX_RETRIES=0
AI_MODEL_TEMPERATURE=0.7
AI_MODEL_MAX_COMPLETION_TOKENS=2048
AI_REQUEST_MAX_AGE_SECONDS=60
AI_MAX_CONCURRENT_REQUESTS=20
AI_MAX_INPUT_CHARS=4000
AI_STREAM_TIMEOUT_SECONDS=75
AI_MODEL_FAILURE_THRESHOLD=3
AI_MODEL_RECOVERY_SECONDS=30
