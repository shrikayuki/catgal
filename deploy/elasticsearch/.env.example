# Keep Elasticsearch and Kibana on the same 8.x version.
STACK_VERSION=8.11.0
CLUSTER_NAME=catgal-search

# Certificate SAN for the VM. Change this if the VM address changes.
ES_HOST_IP=192.168.150.104

# Bind only to the VMware host-only address. Use 127.0.0.1 for VM-local access only.
ES_PORT=192.168.150.104:9200
KIBANA_PORT=192.168.150.104:5601

# Use separate 32+ character alphanumeric passwords. Do not commit the real .env file.
ELASTIC_PASSWORD=replaceWithStrongElasticPassword123456
KIBANA_PASSWORD=replaceWithStrongKibanaPassword1234567

# Each Kibana encryption key must contain at least 32 characters.
KIBANA_SECURITY_ENCRYPTION_KEY=replaceWith32CharacterSecurityKey01
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=replaceWith32CharacterSavedObjectsKey
KIBANA_REPORTING_ENCRYPTION_KEY=replaceWith32CharacterReportingKey001

# 1 GB heap / 2 GB container is suitable for this development VM.
ES_HEAP_SIZE=1g
ES_MEM_LIMIT=2g
KIBANA_MEM_LIMIT=1g
